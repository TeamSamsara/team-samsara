# Copy this file to .env.development, .env.staging and .env.production and fill in
# the values for that environment. The real .env.* files are never committed.
#
# Which file is read depends on the Vite mode, not on the build type:
#   npm run dev            -> .env.development   (vite --mode development)
#   npm run dev:staging    -> .env.staging       (vite --mode staging)
#   npm run build:staging  -> .env.staging       (vite build --mode staging)
#   npm run build          -> .env.production    (vite build --mode production)
#
# The app validates all of this at startup and lists every problem it finds.

# Required. The environment this file belongs to: development, staging or production.
# It must match the mode above, so a copied file used in the wrong mode is caught.
VITE_APP_ENV=

# Required. Base URL of the API.
# staging and production: an absolute https URL.
# development only: also accepts the Vite dev proxy path, for example /api.
VITE_API_BASE_URL=

# Optional. Serve assets (images) from another API than VITE_API_BASE_URL, for example
# staging images while the local API has none. Empty means the API base URL is used.
VITE_ASSETS_BASE_URL=

# Required. Firebase web app configuration for this environment's Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional, development only. Full URL of the Firebase Auth emulator.
# Defaults to http://localhost:9099 when unset. Setting it in .env.staging or
# .env.production stops the app at startup: the emulator is never allowed there.
VITE_FIREBASE_AUTH_EMULATOR_HOST=
