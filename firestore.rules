rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    function isModerator() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Moderator'];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===== USERS COLLECTION =====
    // Owned by the API (Admin SDK bypasses rules). Holds security state
    // (AccessLevel, VerifiedSignIns, KnownFingerprints), so no client access.
    match /users/{userId} {
      allow read, write: if false;
    }

    // ===== PROFILES COLLECTION =====
    // Owned by the API (Admin SDK bypasses rules). No client access.
    match /profiles/{userId} {
      allow read, write: if false;
    }

    // ===== VERIFICATION CODES COLLECTION =====
    // Owned by the API (Admin SDK bypasses rules). Holds code hashes, so no client access.
    match /verificationCodes/{codeId} {
      allow read, write: if false;
    }

    // ===== PASSWORD RESET TOKENS COLLECTION =====
    // Owned by the API (Admin SDK bypasses rules). Holds token hashes, so no client access.
    match /passwordResetTokens/{tokenId} {
      allow read, write: if false;
    }

    // ===== EMAIL CHANGE REQUESTS COLLECTION =====
    // Owned by the API (Admin SDK bypasses rules). Holds the requested new address, so no client access.
    match /emailChangeRequests/{userId} {
      allow read, write: if false;
    }

    // ===== VERIFICATIONS COLLECTION (LEGACY) =====
    // No longer used by anything. The old rules let anyone read documents that had a
    // CodeHash and let any signed-in user create documents, so it is closed completely.
    match /verifications/{verificationId} {
      allow read, write: if false;
    }

    // ===== SOCIAL ACCOUNTS COLLECTION (LEGACY) =====
    // No longer used by anything. Closed completely; reopen deliberately if a feature needs it.
    match /social_accounts/{socialAccountId} {
      allow read, write: if false;
    }

    // ===== AUDIT LOGS COLLECTION =====
    match /audit_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ===== LANDING PAGE LEADS (PUBLIC) =====
    match /landing-leads/{leadId} {
      // Allow LIMITED read access for duplicate email checking
      // This is safe because:
      // 1. Queries must filter by email (prevents reading all leads)
      // 2. Limit must be 1 (prevents bulk reads)
      // 3. Only returns if exact email match exists
      allow get: if false; // Can't read individual documents
      allow list: if
        request.query.limit == 1 &&
        request.query.matches('email');

      // Allow anyone to create a lead with strict validation
      allow create: if
        // Must have exactly these fields
        request.resource.data.keys().hasAll(['name', 'email', 'timestamp', 'source']) &&
        request.resource.data.keys().hasOnly(['name', 'email', 'timestamp', 'source']) &&
        // Name validation
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        // Email validation
        request.resource.data.email is string &&
        request.resource.data.email.matches('.*@.*\\..*') &&
        request.resource.data.email.size() >= 5 &&
        request.resource.data.email.size() <= 100 &&
        // Timestamp must be server timestamp
        request.resource.data.timestamp == request.time &&
        // Source must be 'landing-page'
        request.resource.data.source == 'landing-page';

      // Admins can read everything
      allow read: if isAdmin();

      // No updates or deletes allowed
      allow update, delete: if false;
    }

    // ===== CATCH-ALL: DENY EVERYTHING ELSE =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
