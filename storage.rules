rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Public content — images/videos meant for the live, unauthenticated site
    // Matches both the CMS upload convention (content/image/..., content/video/...,
    // content/document/... from FirebaseStorageService.BuildPath) and the root-level
    // manual backfill files from today's migration (Apparel.png, Cedrick.png, etc.)
    match /content/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Everything else stays locked down — auth required both ways
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}